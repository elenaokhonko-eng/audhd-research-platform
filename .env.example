# Environment variables for the Research Multi-Agent System

# Kimi Code API Configuration (OpenAI Compatible)
# Set your Kimi Code API key starting with 'sk-kimi-' (https://kimi.com/code/console)
OPENAI_API_KEY=your_kimi_code_api_key_here

# Kimi Code Dedicated API Gateway Endpoint
OPENAI_API_BASE=https://api.kimi.com/coding/v1

# Highly available Kimi Code model (or 'k3')
OPENAI_MODEL_NAME=kimi-for-coding

# Optional: Serper API Key for web search tools (https://serper.dev/)
SERPER_API_KEY=your_serper_api_key_here

# Optional: Langtrace or Langfuse for tracing & telemetry
# LANGTRACE_API_KEY=your_langtrace_api_key_here
# LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=audhd-research-platform
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Platform services (local Docker Compose defaults)
DATABASE_URL=postgresql+psycopg://audhd:audhd@localhost:5432/audhd
REDIS_URL=redis://localhost:6379/0
ARTIFACT_BUCKET=audhd-artifacts
ARTIFACT_ENDPOINT=http://localhost:9000
AWS_REGION=ap-southeast-1

# Safety gates
REQUIRE_DEIDENTIFIED_CLINICAL_DATA=true
SUBSTACK_PUBLISH_ENABLED=false
