# Copy to terraform.tfvars (git-ignored) and fill in. The bootstrap script writes this for you.
project_id         = "audhd-neurobiology-prod"
region             = "asia-southeast1"
billing_account_id = "XXXXXX-XXXXXX-XXXXXX"
alert_email        = "you@example.com"
budget_amount      = 30

# Step 2 of the runbook turns these on after the domain is verified:
map_custom_domains    = false
manage_cloudflare_dns = false
cloudflare_zone_id    = ""
# cloudflare_api_token comes from the environment: export TF_VAR_cloudflare_api_token=...

# Step 3, once https://audhdneurobiology.org serves with a certificate:
check_custom_domain = false

# Wave 2: the reconcile and roster jobs.
# Stripe application id of Substack's subscriptions (from a Substack-created subscription in Stripe; leave empty until known).
stripe_substack_application = ""
# What a paying Substack reader is recorded as, per plan interval: "tier:paid" or "status:substack_paid".
substack_grant_month = "status:substack_paid"
substack_grant_year  = "status:substack_paid"
# How often the reconcile runs (cron, UTC, at least 10 minutes apart); shorten while a campaign is open.
reconcile_schedule = "*/30 * * * *"
# Runs the schedule and lets platform-api start the reconcile ("Check again", sign-in refresh).
# Off at first; set to true after the first good real run (launch runbook).
reconcile_schedule_enabled = false
# Your Google account ids allowed to call the owner's routes: the "sub" of your identity token (the launch runbook gives the command). Empty until then.
owner_account_ids = []
# Offer "Sign in with Google" on the website; true once the Google provider is set up.
google_sign_in_enabled = false
