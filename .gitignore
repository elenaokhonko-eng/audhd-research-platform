profile_default/
ipython_config.py

# pyenv
#   For a library or package, you might want to ignore these files since the code is
#   intended to run in multiple environments; otherwise, check them in:
# .python-version

# pipenv
#   According to pypa/pipenv#598, it is recommended to include Pipfile.lock in version control.
#   However, in case of collaboration, if having platform-specific dependencies or dependencies
#   having no cross-platform support, pipenv may install dependencies that don't work, or not
#   install all needed dependencies.
#Pipfile.lock

# poetry
#   Similar to Pipfile.lock, poetry.lock contains the exact dependency versions and should be tracked.
#poetry.lock

# pdm
#   Similar to Pipfile.lock, pdm.lock contains the exact dependency versions and should be tracked.
#.pdm-plugins.toml
#.pdm-pyproject.toml

# PEP 582; used by e.g. github.com/lincolnloop/layman and github.com/pdm-project/pdm
__pypackages__/

# Celery stuff
celerybeat-schedule
celerybeat.pid

# SageMath Parsed Files
*.sage.py

# Environments
.env
.venv
.venv-python314-backup/
env/
venv/
ENV/
env.bak/
venv.bak/

# Spyder project settings
.spyderproject
.spyderworkspace

# VS Code settings (specific workspace overrides we don't want to force if collaborating,
# but we check-in configuration settings/launch, so we only ignore individual user states)
.vscode/.suo
.vscode/workspace.json
.vscode/*.code-workspace

# OS files
.DS_Store
Thumbs.db

# Output Research Report
final_research_report.md
artifacts/
tmp/

# Terraform (state lives in GCS; tfvars may hold ids and are written per machine)
.terraform/
*.tfstate
*.tfstate.*
terraform.tfvars
.terraform.lock.hcl.bak

