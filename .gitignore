# ops/scripts/check-private-content.sh enforces the same rules.
# ---------------------------------------------------------------
/series/
/canon/
/private/
/unsorted/
/standalone/
/audhd-research-private/
/audhd-research-publication/
*.docx
*.pptx
*.pptd
*.zip
*.bundle

# Agent build workspaces: lane ledgers, worktrees, local settings
.superpowers/
.claude/worktrees/
.claude/settings.local.json
