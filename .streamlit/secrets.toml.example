# Copy to .streamlit/secrets.toml for local OIDC testing. Never commit the real file.
[auth]
redirect_uri = "http://localhost:8501/oauth2callback"
cookie_secret = "replace-with-a-long-random-secret"
client_id = "replace-with-oidc-client-id"
client_secret = "replace-with-oidc-client-secret"
server_metadata_url = "https://login.microsoftonline.com/YOUR_TENANT_ID/v2.0/.well-known/openid-configuration"
